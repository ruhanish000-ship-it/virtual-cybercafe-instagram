# Only needed for live Instagram publishing
IG_USER_ID=your_instagram_professional_account_id
TOKEN_ENCRYPTION_KEY=generated_by_bootstrap_token_script

# Optional. The automation works without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Safety switch: dry-run or live
PUBLISH_MODE=dry-run
PUBLISH_STATIC_POST=true
META_API_VERSION=v26.0

# Optional brand customisation
BRAND_NAME=Virtual Cyber Cafe
INSTAGRAM_HANDLE=@Virtual_cybercafe
CTA_KEYWORD=HELP
SERVICE_AREA=Delhi & Online Assistance
